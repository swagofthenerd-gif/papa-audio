# Derive centre and rear channels from stereo sources.
#
# These are CLIENT stream properties — setting channelmix.* on a sink node has
# no effect, which is a subtle and easily-missed distinction. Without this, a
# stereo track played to a 5.1 sink puts audio in the front pair only and pads
# the rest with silence.
#
# lfe-cutoff generates a subwoofer channel from low frequencies, which stereo
# sources do not otherwise have at all.
stream.properties = {
    channelmix.upmix         = true
    channelmix.upmix-method  = psd
    channelmix.lfe-cutoff    = 150
    channelmix.fc-cutoff     = 12000
    channelmix.rear-delay    = 12.0
    channelmix.stereo-widen  = 0.0
    channelmix.normalize     = false
}
