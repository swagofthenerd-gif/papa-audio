#!/usr/bin/env bash
# Switch the system-wide EQ preset.
#   eqmode            list presets, show the active one
#   eqmode music      switch to that preset
#
# Each preset is its own PipeWire filter-chain sink, so switching is just a
# default-sink change plus moving live streams — instant, no restart, no
# audio drop. Idle chains cost nothing while suspended.
set -uo pipefail

list_sinks() { pactl list sinks short 2>/dev/null | awk '{print $2}' | grep '^papa_eq_' || true; }
desc_of() { pactl list sinks 2>/dev/null | grep -A3 "Name: $1\$" | grep -m1 "Description:" | sed 's/.*Description: //'; }
current() { pactl info 2>/dev/null | awk -F': ' '/Default Sink/{print $2}'; }

# Each preset exists twice. The plain name boosts the LFE, because an upmix
# synthesises that channel about 10 dB below where the standard puts it. The
# "51" variant leaves LFE alone, for material that already has a real one.
if [ $# -eq 0 ]; then
  cur=$(current)
  echo "Presets — for stereo sources (LFE boosted for the upmix):"
  while read -r s; do
    [ -z "$s" ] && continue
    case "$s" in *51) continue ;; esac
    mark="  "; [ "$s" = "$cur" ] && mark="* "
    printf "%s%-14s %s\n" "$mark" "${s#papa_eq_}" "$(desc_of "$s")"
  done < <(list_sinks)
  echo
  echo "Same presets for native 5.1 sources (LFE untouched) — add 51:"
  while read -r s; do
    [ -z "$s" ] && continue
    case "$s" in *51) ;; *) continue ;; esac
    mark="  "; [ "$s" = "$cur" ] && mark="* "
    printf "%s%-14s\n" "$mark" "${s#papa_eq_}"
  done < <(list_sinks)
  echo
  echo "Active: ${cur:-none}"
  echo "  ('eqmode off' bypasses the EQ entirely)"
  [ "${cur:-}" = "${cur#papa_eq_}" ] && echo "  (not an EQ preset — audio is bypassing the EQ)"
  exit 0
fi

# "off" bypasses the EQ entirely — straight to the 5.1 hardware sink. The
# correction and bass management go away with it, so the satellites get full
# range again.
if [ "$1" = "off" ] || [ "$1" = "bypass" ]; then
  HW=$(pactl list sinks short 2>/dev/null | awk '/analog-surround-51/{print $2; exit}')
  [ -z "$HW" ] && { echo "5.1 hardware sink not found" >&2; exit 1; }
  pactl set-default-sink "$HW" >/dev/null 2>&1
  for i in $(pactl list sink-inputs short 2>/dev/null | cut -f1); do
    pactl move-sink-input "$i" "$HW" >/dev/null 2>&1
  done
  echo "EQ: OFF — direct to hardware (no correction, no bass management)"
  exit 0
fi

want="papa_eq_$1"
if ! list_sinks | grep -qx "$want"; then
  match=$(list_sinks | grep -i "^papa_eq_$1" | head -2)
  n=$(printf '%s' "$match" | grep -c . || true)
  if [ "$n" = "1" ]; then want="$match"
  else
    echo "No preset matching '$1'." >&2
    echo "Available: $(list_sinks | sed 's/^papa_eq_//' | tr '\n' ' ')" >&2
    exit 1
  fi
fi

pactl set-default-sink "$want" >/dev/null 2>&1 || { echo "failed to set default sink" >&2; exit 1; }
# Move anything already playing, otherwise running apps stay on the old preset.
for i in $(pactl list sink-inputs short 2>/dev/null | cut -f1); do
  pactl move-sink-input "$i" "$want" >/dev/null 2>&1
done
echo "EQ: $(desc_of "$want")"
